diff --git a/src/main.c b/src/main.c
index 1bdb1b7..6e5ac45 100644
--- a/src/main.c
+++ b/src/main.c
@@ -9,6 +9,7 @@
 #include <string.h>
 #include "usb_descriptors.h"
 #include "uvc.h"
+#include "input_receiver.h"
 
 #ifdef DEBUG
 
@@ -508,7 +509,7 @@ static int uvc_driver_stop(int size, void *p, void *user_data)
 
 static SceUdcdDriver uvc_udcd_driver = {
 	.driverName			= UVC_DRIVER_NAME,
-	.numEndpoints			= 2,
+	.numEndpoints			= 3,
 	.endpoints			= endpoints,
 	.interface			= &interface,
 	.descriptor_hi			= &devdesc_hi,
@@ -910,6 +911,14 @@ int uvc_start(void)
 	memcpy(&uvc_probe_control_setting, &uvc_probe_control_setting_default,
 	       sizeof(uvc_probe_control_setting));
 
+	/*
+	 * Start the VITA5 USB pad input receiver (interface 2, bulk OUT
+	 * 0x02). On failure video streaming keeps working on its own.
+	 */
+	ret = input_receiver_init(&endpoints[2]);
+	if (ret < 0)
+		LOG("Error starting the input receiver (0x%08X)\n", ret);
+
 	return 0;
 
 err_alloc_uvc_frame_req:
@@ -923,6 +932,7 @@ err_start_uvc_driver:
 
 int uvc_stop(void)
 {
+	input_receiver_term();
 	ksceUdcdDeactivate();
 	ksceUdcdStop(UVC_DRIVER_NAME, 0, NULL);
 	ksceUdcdStop("USBDeviceControllerDriver", 0, NULL);
